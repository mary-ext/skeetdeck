+const eachLimit = (values, limit, iterator) => {
+    return new Promise((res, rej) => {
+        let active = 0;
+        let current = 0;
+        
+        let fulfilled = false;
+        
+        const resolve = () => {
+            if (fulfilled || active > 0) {
+                return;
+            }
+            
+            fulfilled = true;
+            res();
+        };
+        
+        const reject = (err) => {
+            if (fulfilled) {
+                return;
+            }
+            
+            rej(err);
+        };
+        
+        const run = () => {
+            const c = current++;
+            
+            if (fulfilled) {
+                return;
+            }
+            if (c >= values.length) {
+                return resolve();
+            }
+            
+            const value = values[c];
+            
+            active++;
+            
+            try {
+                const ret = iterator(value, c);
+                
+                if (ret && 'then' in ret) {
+                    ret.then(() => {
+                        active--;
+                        run();
+                    }, rej);
+                } else {
+                    active--;
+                    run();
+                }
+            } catch (err) {
+                reject(err);
+            }
+        };
+        
+        for (let i = 0; i < limit; i++) {
+            run();
+        }
+    });
+};
